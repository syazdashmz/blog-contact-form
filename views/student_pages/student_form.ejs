<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/header.css" />
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <title><%= title %></title>
</head>
<body>
    <div class="header">
        <h1><%= title %></h1>
        <p><%= content %></p>
    </div>

    <div class="form-container">
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>

        <form action="<%= formAction %>" method="POST">
            <% if (student) { %>
                <input type="hidden" name="_method" value="PUT">
            <% } %>

            <label for="name">Name:</label>
            <input type="text" name="name" placeholder="Enter full name"
                value="<%= values ? values.name : '' %>">

            <label for="studentNo">Student Number:</label>
            <input type="text" name="studentNo" placeholder="Enter student number (e.g. STD01234 or 2024001)"
                value="<%= values ? values.student_no : '' %>">

            <label for="email">Email:</label>
            <input type="text" name="email" placeholder="Enter email (e.g. name@example.com)"
                value="<%= values ? values.email : '' %>">

            <label for="phone">Phone Number:</label>
            <input type="text" name="phone" placeholder="Enter phone number (e.g. 0128330631 or +60-12-833-0631)"
                value="<%= values ? values.phone : '' %>">

            <div class="button-group">
                <button type="submit" class="save-btn">
                    <i class="fa-solid fa-floppy-disk"></i>
                    <%= student ? 'Update' : 'Save' %>
                </button>
                <a href="/students" class="back-button">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
            </div>
        </form>
    </div>
</body>
</html>